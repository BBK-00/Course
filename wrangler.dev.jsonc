{
  "name": "bbk-courses-dev",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "assets": { "directory": ".dev-site", "binding": "ASSETS", "run_worker_first": ["/python/*", "/scratch/*", "/sandyq-adister/*", "/akt/*"] },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bbk-media" }],
  "d1_databases": [{ "binding": "DB", "database_name": "bbk-courses-db", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }]
}
